# esp-ota-https default sdkconfig overrides
# Target: ESP32 (ESP32-DevKitC-32E). See docs/hardware/BOM.md.

# --- OTA needs two "ota_0"/"ota_1" app slots + an otadata partition,
#     not the default single-app table. ---
CONFIG_PARTITION_TABLE_TWO_OTA=y

# --- The two-OTA-slot partition table (3.1MB total) doesn't fit in the
#     default 2MB flash size assumption -- confirmed via CI ("Partitions
#     tables occupies 3.1MB ... does not fit in configured flash size
#     2MB"). ESP32-DevKitC-32E boards ship with 4MB flash (see
#     docs/hardware/BOM.md), so this matches the actual hardware, not
#     just a workaround. ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- mbedTLS: verify the server's certificate against our pinned CA;
#     never disable verification. See docs/ARCHITECTURE.md. ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_ESP_TLS_INSECURE=n
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=n

# --- esp_https_ota: verify image is a signed/expected app image before
#     marking it bootable. --
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n

# --- Log level: keep the manifest/version/OTA decision trail visible. ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
